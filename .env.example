# Required. Your OpenAI API key.
OPENAI_API_KEY=

# Optional. "local" (default) or "s3". Local runs need no AWS credentials
# at all. "s3" restores the original S3-backed storage behind the same
# read/write interface (control_plane/storage.py).
STORAGE_BACKEND=local

# Optional. Root directory for the local storage backend, relative to the
# repo root unless given as an absolute path. Defaults to "data".
LOCAL_DATA_DIR=data

# Only read when STORAGE_BACKEND=s3. Fall back to the original bucket/region
# if unset.
# S3_BUCKET=
# AWS_REGION=
